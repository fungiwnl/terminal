{
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "rm -rf _site && mkdir _site && cp -R src/. assets _site/",
    "start": "npm run build && python3 -m http.server 8080 -d _site",
    "test": "playwright test",
    "prepare": "git config core.hooksPath .githooks",
    "test:update": "playwright test tests/visual.spec.js --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
